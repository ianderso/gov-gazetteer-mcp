# Copy to .env to change a default. Nothing here is required: GOV's web
# services need no key and no account.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/gov-gazetteer-mcp`.
# Variables already set in the environment take precedence.

# Optional: an email address or URL added to the User-Agent, so CompGen can
# reach you if your use ever causes it trouble.
# GOV_GAZETTEER_CONTACT=you@example.org

# Optional: directory for the on-disk response cache.
# GOV_GAZETTEER_CACHE_DIR=~/.cache/gov-gazetteer-mcp

# Optional: HTTP timeout in seconds for one request (default 30).
# GOV_GAZETTEER_TIMEOUT=30

# Optional: least seconds between two requests to GOV (default 1, never
# below 1). GOV is run by volunteers; please do not lower the pace.
# GOV_GAZETTEER_MIN_INTERVAL=1
